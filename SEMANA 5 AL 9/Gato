package jherencia;

class Gato extends Animal {
    private String raza;
    private String color;

    public Gato() {
    }
    
    public Gato(String especie, String raza) {
        super(especie);
        this.raza = raza;
        this.color = color;
        
    }
    
        public String getRaza() {
            return raza;
        }

        public void setRaza(String raza) {
            this.raza = raza;
        }

        public String getColor() {
        return color;
    }

        public void setColor(String color) {
        this.color = color;
    }
        
    
    public void hacerSonido () { 
            System.out.println("El gato hace miauuuu");
    }
     
    public void color (){
        System.out.println("El color del gato es: " +  this.color);
    }
    
    public void jugar () {
        System.out.println("El gato juega todos los dias");
    }
    
}
